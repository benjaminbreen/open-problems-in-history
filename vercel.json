{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/suggest",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/rate.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(img|og|shared)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/problems.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/p/indian-ocean-tsunamis",
      "destination": "/p/sumatra-tsunamis",
      "permanent": true
    },
    {
      "source": "/p/padang-1697",
      "destination": "/p/sumatra-tsunamis",
      "permanent": true
    },
    {
      "source": "/p/mughal-dodo",
      "destination": "/null-results/mughal-dodo",
      "permanent": true
    },
    {
      "source": "/leads/mughal-dodo",
      "destination": "/null-results/mughal-dodo",
      "permanent": true
    },
    {
      "source": "/p/james-pawpaw-remedy",
      "destination": "/p/sloane-informants#james-pawpaw",
      "permanent": true
    },
    {
      "source": "/p/langley-notebooks",
      "destination": "/leads/langley-kite",
      "permanent": true
    },
    {
      "source": "/p/button-and-button-hole",
      "destination": "/p/anonymous-imprints#approach",
      "permanent": true
    },
    {
      "source": "/p/unattributed-eruptions",
      "destination": "/p/eruption-1809",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/cautionary-tales",
      "destination": "/leads#cautionary-tales",
      "permanent": false
    },
    {
      "source": "/null-results",
      "destination": "/leads#null-results",
      "permanent": false
    }
  ]
}
